{
  "maxReasoningSteps": 5,
  "maxToolExecutions": 5,
  "streamResponses": true,
  "enableInterruptions": true,
  "workspaceRoot": "../workspace/shared",
  "autoloadTools": [
    "shared/FileTool",
    "shared/FolderTool",
    "shared/MemoryTool",
    "shared/memory-read",
    "shared/memory-write",
    "shared/memory-delete"
  ],
  "autoloadPlugins": [
    "shared/logging"
  ],
  "autoloadSkills": [],
  "autoloadCommands": [
