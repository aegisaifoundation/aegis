    "shared/plugins",
    "shared/skills",
    "shared/add",
    "shared/remove",
    "shared/update",
    "shared/status",
    "shared/clear",
    "shared/reload",
    "shared/exit",
    "shared/provider",
    "shared/switch",
    "shared/new",
    "shared/checkout",
    "shared/sessions",
    "shared/current",
    "shared/archive",
    "shared/resume",
    "shared/delete-session",
    "shared/fork-session",
    "shared/rename-session",
    "shared/purge-session",
