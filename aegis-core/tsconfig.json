{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "#/*": ["./*"],
      "@/*": ["./src/*"],
      "execa": ["node_modules/execa"]
    }
  },
  "include": ["src/**/*", "../interfaces/**/*", "../tools/**/*"],
  "exclude": ["node_modules", "dist"]
}
