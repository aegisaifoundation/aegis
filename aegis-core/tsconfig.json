{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "#/*": ["./*"],
      "@/*": ["./src/*"],
      "execa": ["node_modules/execa"],
      "react": ["node_modules/react"],
      "ink": ["node_modules/ink"],
      "ink-text-input": ["node_modules/ink-text-input"],
      "react/jsx-runtime": ["node_modules/react/jsx-runtime"]
    },
    "noImplicitAny": false
  },
  "include": ["src/**/*", "../interfaces/**/*", "../tools/**/*"],
  "exclude": ["node_modules", "dist"]
}
