{
  "name": "aegis-core",
  "version": "1.0.0",
  "description": "Aegis Core Agent - Terminal AI",
  "main": "dist/aegis-core/src/index.js",
  "type": "module",
  "scripts": {
    "start": "node --experimental-specifier-resolution=node --no-warnings dist/aegis-core/src/index.js",
    "dev": "node --import tsx --experimental-specifier-resolution=node --no-warnings src/index.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "bin": {
    "aegis": "bin/aegis.js"
  },
  "dependencies": {
    "@aegis/runtime": "*",
    "@aegis/memory": "*",
    "@aegis/agent": "*",
    "@aegis/providers": "*",
    "@aegis/tools": "*",
    "@aegis/skills": "*",
    "@aegis/plugins": "*",
    "@aegis/api": "*",
    "axios": "^1.7.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "eventemitter3": "^5.0.1",
    "execa": "^9.3.0",
    "ink": "^4.4.1",
    "ink-text-input": "^5.0.1",
    "inquirer": "^9.2.8",
    "ollama": "^0.5.1",
    "react": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "cross-env": "^10.1.0",
    "tsx": "^4.15.2",
    "typescript": "^5.4.5"
  }
}
