{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryEvent",
  "type": "object",
  "required": ["event", "timestamp", "source", "payload"],
  "properties": {
    "event": {
      "type": "string"
    },
    "timestamp": {
      "type": "number"
    },
    "source": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "required": ["sessionId"],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "memoryType": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
